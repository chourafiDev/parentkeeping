# Postgres. Local dev: postgres://localhost:5432/parentkeeping (plain driver).
# Production: Neon pooled URL (serverless driver) + unpooled URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (admin accounts). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Transactional email (Brevo). Empty in dev: emails are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@parentkeeping.com
EMAIL_FROM_NAME=Parentkeeping

# Cloudflare R2 (S3-compatible). Private bucket = product files (signed links only);
# public bucket = product cover images. Empty in dev: files go to ./.storage instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# Stripe (test mode keys first: sk_test_…). Needed for refunds from the admin and checkout.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…). Locally: `stripe listen --forward-to localhost:3001/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=
# Public site URL for Stripe redirects and email links, e.g. https://parentkeeping.com (dev: http://localhost:3001)
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (bot check on the free-list form). Empty: honeypot only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
