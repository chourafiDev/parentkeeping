# Postgres. Local dev: postgres://localhost:5432/parentkeeping (plain driver).
# Production: Neon pooled URL (serverless driver) + unpooled URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (admin accounts). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Transactional email (Brevo). Empty in dev: emails are printed to the terminal.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=hello@parentkeeping.com
EMAIL_FROM_NAME=Parentkeeping

# Cloudflare R2 (S3-compatible). Private bucket = product files (signed links only);
# public bucket = product cover images. Empty in dev: files go to ./.storage instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
